<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fon_new"
    tools:context=".fragments.TasbeehFragment">

    <!-- Header Section - 32% of screen height -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.32"
        app:layout_constraintTop_toTopOf="parent">

        <ViewFlipper
            android:id="@+id/iv_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="4000"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/qibla_img" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_qibla_1" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_qibla_2" />
        </ViewFlipper>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#50000000" />

        <TextView
            android:id="@+id/tv_zikr_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="55dp"
            android:text="سبحان الله"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_zikr_english"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Subhanalloh"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_zikr_arabic" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="55dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/ripple_circle"
            android:padding="10dp"
            android:src="@drawable/ic_infooo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/ll_cards"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="-55dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cl_header">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_33"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_qibla_1" />
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70000000" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_above="@+id/tv_l33" android:layout_marginStart="12dp" android:text="33" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_l33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginStart="12dp" android:layout_marginBottom="12dp" android:text="Subhanalloh" android:textColor="@color/white" android:textSize="10sp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_66"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/qibla_img" />
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70000000" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_above="@+id/tv_l66" android:layout_marginStart="12dp" android:text="66" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_l66" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginStart="12dp" android:layout_marginBottom="12dp" android:text="Alhamdulillah" android:textColor="@color/white" android:textSize="10sp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_99"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_qibla_2" />
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70000000" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_above="@+id/tv_l99" android:layout_marginStart="12dp" android:text="99" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_l99" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginStart="12dp" android:layout_marginBottom="12dp" android:text="Allohu Akbar" android:textColor="@color/white" android:textSize="10sp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Tasbeh Device Body - Centered Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_tasbeh_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.78"
        app:layout_constraintDimensionRatio="H,1:1.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_cards"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginVertical="10dp">

        <ImageView
            android:id="@+id/tasbeh_qolip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/tv_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="80sp"
            app:layout_constraintWidth_percent="0.55"
            app:layout_constraintHeight_percent="0.22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.304" />

        <ImageView
            android:id="@+id/btn_count_tasbeh"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.38"
            app:layout_constraintDimensionRatio="1:1"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.76" />

        <ImageView
            android:id="@+id/btn_restart_tasbeh"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/ripple_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_restart_button_gold"
            app:layout_constraintVertical_bias="0.475"
            app:layout_constraintWidth_percent="0.16" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>